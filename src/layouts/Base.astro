---
import { ViewTransitions } from 'astro:transitions';

interface Props { lang: 'zh' | 'en'; title?: string; description?: string; }
const { lang, title = 'Schlaflied', description = 'A room for things worth remembering.' } = Astro.props;
const isZh = lang === 'zh';
const copy = isZh ? {
  byline: 'Syna 的一间房', nav: [['首页', `/${lang}/`], ['作品', `/${lang}/works/`], ['写作', `/${lang}/writing/`], ['随记', `/${lang}/notes/`], ['关于', `/${lang}/about/`]],
  theme: '切换亮暗主题', menu: '打开菜单', language: '切换到 English'
} : {
  byline: 'a room by Syna', nav: [['home', `/${lang}/`], ['works', `/${lang}/works/`], ['writing', `/${lang}/writing/`], ['notes', `/${lang}/notes/`], ['about', `/${lang}/about/`]],
  theme: 'Change colour theme', menu: 'Open menu', language: '切换到中文'
};
const other = isZh ? 'en' : 'zh';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · Schlaflied</title>
    <ViewTransitions />
    <script is:inline>
      const saved = localStorage.getItem('schlaflied-theme');
      document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{isZh ? '跳到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <a class="wordmark" href={`/${lang}/`} aria-label="Schlaflied home">
        <span>Schlaflied</span><small>{copy.byline}</small>
      </a>
      <div class="header-actions">
        <a class="language" href={`/${other}/`} aria-label={copy.language}>{isZh ? <><span>中文 / </span><b>EN</b></> : <><b>中文</b><span> / EN</span></>}</a>
        <button class="theme-toggle" type="button" aria-label={copy.theme} title={copy.theme}><span aria-hidden="true">☼</span><span aria-hidden="true">☾</span></button>
        <button class="menu-toggle" type="button" aria-label={copy.menu} aria-expanded="false">☰</button>
      </div>
      <nav aria-label={isZh ? '主导航' : 'Main navigation'}>
        {copy.nav.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer><span>Schlaflied</span><span>—</span><span>{isZh ? '给还在生长的东西留一盏灯。' : 'A small light for things still growing.'}</span></footer>
    <script>
      const toggle = document.querySelector('.theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('schlaflied-theme', next);
      });
      const menu = document.querySelector('.menu-toggle'); const nav = document.querySelector('nav');
      menu?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); menu.setAttribute('aria-expanded', String(open)); });
    </script>
  </body>
</html>

<style is:global>
  :root { --paper:#f4efe3; --paper-deep:#e9e0cf; --ink:#1d3546; --muted:#716b62; --rose:#b26b6b; --line:#cbbda9; --amber:#b78b52; }
  :root[data-theme='dark'] { --paper:#101b31; --paper-deep:#172640; --ink:#f2e9d8; --muted:#b9b2a7; --rose:#d5908b; --line:#496076; --amber:#d9ad69; }
  * { box-sizing:border-box; } html { background:var(--paper); scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family: Georgia, 'Noto Serif SC', 'Songti SC', serif; line-height:1.65; transition:background-color .45s ease, color .45s ease; }
  a { color:inherit; text-decoration:none; } .skip { position:absolute; left:-999px; } .skip:focus { left:1rem; top:1rem; background:var(--ink); color:var(--paper); padding:.5rem; z-index:3; }
  .site-header { max-width:1160px; margin:auto; padding:26px 28px 18px; display:grid; grid-template-columns:1fr auto; align-items:start; border-bottom:1px solid var(--line); }
  .wordmark { font-size:1.15rem; letter-spacing:.02em; display:grid; justify-self:start; line-height:1.15; } .wordmark small { color:var(--muted); font-size:.7rem; font-style:italic; letter-spacing:.03em; margin-top:4px; }
  .header-actions { display:flex; gap:11px; align-items:center; font-family:ui-sans-serif, system-ui, sans-serif; font-size:.76rem; letter-spacing:.04em; } .language { border-bottom:1px solid var(--rose); padding:3px 0; } .language b { color:var(--rose); font-weight:600; }
  button { appearance:none; background:transparent; color:var(--ink); border:1px solid var(--line); cursor:pointer; font:inherit; } .theme-toggle { border-radius:999px; padding:3px 8px; display:flex; gap:8px; } :root[data-theme='light'] .theme-toggle span:last-child, :root[data-theme='dark'] .theme-toggle span:first-child { opacity:.35; }
  .menu-toggle { display:none; padding:3px 7px; } nav { grid-column:1/-1; display:flex; gap:25px; margin-top:21px; font-family:ui-sans-serif, system-ui, sans-serif; font-size:.78rem; letter-spacing:.05em; text-transform:uppercase; } nav a { color:var(--muted); } nav a:hover { color:var(--rose); }
  main { max-width:1160px; margin:auto; padding:0 28px; min-height:70vh; } footer { max-width:1160px; margin:80px auto 0; padding:20px 28px 35px; border-top:1px solid var(--line); color:var(--muted); display:flex; gap:10px; font-size:.78rem; }
  .hero { padding:clamp(70px,13vw,155px) 0 68px; max-width:830px; position:relative; } .eyebrow { font-family:ui-sans-serif,system-ui,sans-serif; color:var(--rose); letter-spacing:.14em; font-size:.72rem; text-transform:uppercase; } h1 { font-size:clamp(2.7rem,7.2vw,6.3rem); line-height:1.1; letter-spacing:-.06em; font-weight:500; margin:15px 0 22px; } .subtitle { color:var(--muted); font-size:clamp(.95rem,1.7vw,1.2rem); }
  .star { color:var(--rose); font-size:1.4rem; margin-left:.15em; vertical-align:top; } .rule { width:68px; height:2px; background:var(--rose); margin:26px 0; }
  .section-heading { display:flex; align-items:baseline; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:12px; margin:40px 0 22px; } h2 { font-size:1.5rem; font-weight:500; letter-spacing:-.03em; margin:0; } .section-heading span { font: .7rem ui-sans-serif,system-ui,sans-serif; color:var(--muted); letter-spacing:.07em; }
  .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; } .card { border:1px solid var(--line); min-height:225px; padding:25px; position:relative; display:flex; flex-direction:column; justify-content:space-between; background:color-mix(in srgb, var(--paper) 91%, var(--paper-deep)); transition:transform .25s ease,border-color .25s ease,background-color .45s ease; } .card:hover { transform:translateY(-3px); border-color:var(--rose); } .card .number { font:.68rem ui-monospace,SFMono-Regular,monospace; color:var(--rose); } .card h3 { font-size:1.55rem; line-height:1.15; font-weight:500; margin:13px 0 8px; } .card p { color:var(--muted); margin:0; font-size:.92rem; max-width:28rem; } .arrow { align-self:flex-end; color:var(--rose); font-size:1.35rem; transition:transform .25s ease; } .card:hover .arrow { transform:translateX(5px); }
  .note { margin:56px 0; padding:25px 0 25px 28px; border-left:2px solid var(--amber); max-width:750px; color:var(--muted); font-size:1.05rem; }
  .prose { max-width:760px; padding:70px 0 0; } .prose h1 { font-size:clamp(2.5rem,5vw,4.5rem); } .prose p { font-size:1.08rem; } .prose .label { color:var(--rose); font: .72rem ui-sans-serif,system-ui,sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  @media (max-width:620px) { .site-header { padding:19px 19px 14px; } main { padding:0 19px; } footer { margin-top:50px; padding:18px 19px 26px; } .menu-toggle { display:block; } nav { display:none; grid-column:1/-1; gap:12px; flex-direction:column; margin:14px 0 0; } nav.open { display:flex; } .grid { grid-template-columns:1fr; } .hero { padding:76px 0 45px; } footer { display:block; } footer span { margin-right:8px; } }
  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; scroll-behavior:auto!important; } }
</style>
