---
const { lang } = Astro.props;
const zh = lang === 'zh';
const content = zh ? {
  eyebrow: '一间公开的阅读室', hero: '这里放着我不想忘记的东西。', subtitle: '写作 · AI · 学习 · 开源 · 生活留下的痕迹', heading: '四扇门', index: 'FOUR DOORS',
  cards: [['01', 'Plot Ark', '一个仍在生长的作品页面。这里留给问题、草图和后来发生的事。', '/zh/works/', 'window'], ['02', 'ClearCover', '一个名字，一条还在被慢慢厘清的线。项目页会在内容准备好后开放。', '/zh/works/', 'vase'], ['03', '写作', '小说、散文和不必立刻证明用途的文字。中文原作优先。', '/zh/writing/', 'book'], ['04', '案件与猫', '案件笔记与生活痕迹有各自的门；公开内容会谨慎删节。', '/zh/notes/', 'flower']],
  note: '这里不是人生的完整备份，也不是履历的陈列柜。它是一张桌面：我选择留在上面的、仍然会发光的小事。'
} : {
  eyebrow: 'A public reading room', hero: 'Here are the things I do not want to forget.', subtitle: 'writing · AI · learning · open source · traces of a life', heading: 'Four doors', index: 'FOUR DOORS',
  cards: [['01', 'Plot Ark', 'A work still becoming. A place for questions, drafts, and what follows.', '/en/works/', 'window'], ['02', 'ClearCover', 'A name, and a thread still being carefully understood. The project page opens when ready.', '/en/works/', 'vase'], ['03', 'Fiction', 'Fiction, essays, and words that need not justify themselves at once. Chinese originals come first.', '/en/writing/', 'book'], ['04', 'Case Notes & Cats', 'Case notes and traces of everyday life have separate doors. Public notes are carefully redacted.', '/en/notes/', 'flower']],
  note: 'This is neither a complete archive of a life nor a cabinet of credentials. It is a desk: small things I have chosen to leave in the light.'
};
---
<div class="home-canvas">
<div class="room-decor" aria-hidden="true">
  <svg class="dry-flower" viewBox="0 0 130 240"><path d="M64 238C60 160 79 95 104 24M68 151C39 132 20 101 17 70M73 124c28-15 43-40 44-69M60 177c-22-8-38-27-44-51"/><path d="M15 70c-13-12 1-30 13-15 1-17 22-13 19 2 14-7 21 12 7 21-10 9-27 7-39-8ZM102 25c-4-17 18-23 22-6 9-12 23 3 13 14 3 14-16 20-28 10-7-5-8-12-7-18ZM28 130c-13-12 1-30 13-15 1-17 22-13 19 2 14-7 21 12 7 21-10 9-27 7-39-8Z"/></svg>
  <div class="tape tape-a"></div><div class="tape tape-b"></div><span class="tiny-star star-a">✦</span><span class="tiny-star star-b">✧</span><div class="old-page"></div>
</div>
<section class="hero reveal"><div class="eyebrow">{content.eyebrow}</div><h1>{content.hero}<span class="star">✦</span></h1><div class="rule"></div><p class="subtitle">{content.subtitle}</p></section>
<section class="doors-section" aria-labelledby="things">
  <div class="section-heading reveal"><h2 id="things">{content.heading}</h2><span>{content.index}</span></div>
  <div class="doors">
    {content.cards.map(([number, title, description, href, icon], index) => <a class="door reveal" data-door={icon} style={`--delay:${index * 90}ms`} href={href}>
      <div class="door-top"><span class="number">{number}</span><div class="icon-frame"><svg class="door-icon" viewBox="0 0 120 108" aria-hidden="true">
        {icon === 'window' && <><path d="M24 94V45a36 36 0 0 1 72 0v49M24 57h72M60 10v84M42 21v73M78 21v73"/><path d="M16 94h88"/></>}
        {icon === 'vase' && <><path d="M51 25h18l-3 20c-1 7 13 13 13 30 0 13-9 19-19 19s-19-6-19-19c0-17 14-23 13-30l-3-20Z"/><path d="M60 25c-1-13 6-18 12-20M60 27C51 15 42 19 38 9M57 31c-13 2-19-7-25-3"/></>}
        {icon === 'book' && <><path d="M15 25c18-7 30-2 45 8v57c-15-10-27-15-45-8V25ZM105 25c-18-7-30-2-45 8v57c15-10 27-15 45-8V25Z"/><path d="M60 33v57M24 41c11-2 20 0 28 5M96 41c-11-2-20 0-28 5"/></>}
        {icon === 'flower' && <><path d="M60 94V52M60 65c-12-4-20-2-27 5M60 72c12-5 20-3 27 4"/><path d="M60 49c-11 0-20-8-20-19 0-7 5-12 11-11 1-7 16-7 18 0 7-1 11 4 11 11 0 11-9 19-20 19Z"/><path d="M60 14v34M45 30h30M49 19l22 22M71 19 49 41"/></>}
      </svg></div></div><div class="door-copy"><h3>{title}</h3><p>{description}</p></div><span class="arrow" aria-hidden="true">→</span>
    </a>)}
  </div>
</section>
<aside class="note desk-note reveal"><span class="note-star">✦</span><strong>{zh ? '灯还亮着。' : 'The light is still on.'}</strong><span>{content.note}</span></aside>
</div>

<style>
  .home-canvas { position:relative; width:100vw; min-height:calc(100vh - 126px); margin-left:calc(50% - 50vw); padding:0 max(34px,calc((100vw - 1162px) / 2)); overflow:hidden; } .room-decor { position:absolute; inset:0; pointer-events:none; overflow:hidden; z-index:0; background:var(--paper); } .room-decor::before,.room-decor::after { content:''; position:absolute; inset:0; background:center top / cover no-repeat; transition:opacity .45s ease; } .room-decor::before { background-image:url('/images/desk-bright-v1.png'); opacity:1; } .room-decor::after { background-image:url('/images/desk-dark-v1.png'); opacity:0; } .room-decor > * { display:none; } .hero,.doors-section,.desk-note { position:relative; z-index:1; }
  .hero { min-height:clamp(360px,42vw,650px); display:flex; flex-direction:column; justify-content:center; } .doors-section { padding-bottom:20px; } .doors { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:22px; }
  .door { --door-paper:#fcf6e8; min-height:274px; padding:14px 17px 13px; display:flex; flex-direction:column; position:relative; isolation:isolate; color:#253947; background:linear-gradient(105deg,rgb(255 255 255 / .68),transparent 32%),var(--door-paper); clip-path:polygon(1.5% .8%,9% 0,18% .6%,29% 0,39% .7%,51% 0,63% .55%,76% 0,89% .7%,99% 0,98.5% 12%,100% 24%,98.6% 37%,100% 51%,98.4% 63%,100% 77%,98.7% 90%,99.5% 99%,88% 98.6%,77% 100%,64% 98.7%,53% 100%,41% 98.6%,28% 100%,16% 98.7%,2% 100%,1.4% 87%,0 74%,1.2% 62%,0 48%,1.4% 36%,0 23%,1.3% 11%); filter:drop-shadow(3px 5px 4px rgb(96 70 38 / .16)); transition:transform .22s ease,filter .22s ease; } .door:hover { transform:translateY(-2px); filter:drop-shadow(3px 7px 6px rgb(96 70 38 / .22)); }
  .door::before { content:''; position:absolute; z-index:-1; inset:7px 6px 8px; background:linear-gradient(90deg,rgb(133 99 60 / .045),transparent 8% 92%,rgb(133 99 60 / .045)); clip-path:polygon(1.5% .8%,9% 0,18% .6%,29% 0,39% .7%,51% 0,63% .55%,76% 0,89% .7%,99% 0,98.5% 12%,100% 24%,98.6% 37%,100% 51%,98.4% 63%,100% 77%,98.7% 90%,99.5% 99%,88% 98.6%,77% 100%,64% 98.7%,53% 100%,41% 98.6%,28% 100%,16% 98.7%,2% 100%,1.4% 87%,0 74%,1.2% 62%,0 48%,1.4% 36%,0 23%,1.3% 11%); } .door::after { content:''; position:absolute; top:-8px; right:24%; width:52px; height:18px; background:rgb(212 190 144 / .42); transform:rotate(2deg); opacity:.78; }
  .door[data-door='vase']::after { left:20%; right:auto; transform:rotate(-3deg); background:rgb(192 136 126 / .27); } .door[data-door='book']::after { right:14%; transform:rotate(5deg); background:rgb(200 162 91 / .29); } .door[data-door='flower']::after { left:35%; right:auto; transform:rotate(-2deg); background:rgb(139 157 112 / .25); }
  .door-top { display:flex; flex-direction:column; align-items:center; gap:3px; } .number { align-self:flex-start; font:.55rem ui-monospace,SFMono-Regular,monospace; color:rgb(178 108 108 / .66); letter-spacing:.08em; } .icon-frame { width:80px; height:78px; display:grid; place-items:center; border:1px solid rgb(178 108 108 / .52); border-radius:41px 41px 3px 3px; background:rgb(255 255 255 / .24); box-shadow:inset 0 0 0 4px rgb(178 108 108 / .055); } .door[data-door='book'] .icon-frame,.door[data-door='flower'] .icon-frame { border-radius:3px; border-style:dashed; } .door-icon { width:58px; height:58px; fill:none; stroke:#aa7662; stroke-width:1.35; stroke-linecap:round; stroke-linejoin:round; }
  .door-copy { margin-top:auto; } .door h3 { font-size:1.17rem; line-height:1.15; font-weight:500; margin:0 0 7px; } .door h3::after { content:''; display:block; width:24px; height:2px; margin-top:8px; background:var(--rose); } .door p { color:#6d665c; margin:0; font-size:.74rem; line-height:1.55; } .arrow { align-self:flex-end; margin-top:9px; color:var(--rose); font-size:1.16rem; transition:transform .22s ease; } .door:hover .arrow { transform:translateX(5px); }
  .desk-note { display:grid; grid-template-columns:auto auto 1fr; align-items:baseline; gap:14px; max-width:850px; margin:54px auto 25px; padding:25px 36px; color:#635d53; border:0; background:linear-gradient(100deg,rgb(255 255 255 / .48),transparent 40%),#efe0c3; clip-path:polygon(1% 2%,16% 0,31% 1%,49% 0,67% 1%,83% 0,99% 2%,98% 18%,100% 33%,98% 49%,100% 67%,98% 84%,99% 98%,81% 100%,63% 99%,46% 100%,28% 99%,13% 100%,1% 98%,2% 79%,0 62%,2% 47%,0 30%,2% 15%); box-shadow:none; filter:drop-shadow(3px 5px 5px rgb(91 65 33 / .11)); } .desk-note strong { color:var(--ink); font-size:1.15rem; font-weight:500; white-space:nowrap; } .desk-note span:last-child { font-size:.92rem; } .note-star { color:var(--rose); }
  .door.reveal { opacity:0; transform:translateY(12px); } .door.reveal.is-visible { opacity:1; transform:translateY(0); transition:opacity .48s ease var(--delay),transform .48s ease var(--delay),filter .22s ease; } .door.reveal.is-visible.settled { transition:transform .22s ease,filter .22s ease; }
  :global(:root[data-theme='dark']) .room-decor::before { opacity:0; } :global(:root[data-theme='dark']) .room-decor::after { opacity:1; } :global(:root[data-theme='dark']) .door { --door-paper:#1c2940; color:#efd9a8; background:linear-gradient(106deg,rgb(235 196 123 / .075),transparent 36%),var(--door-paper); filter:drop-shadow(3px 5px 4px rgb(0 0 0 / .36)); } :global(:root[data-theme='dark']) .door:hover { filter:drop-shadow(3px 7px 6px rgb(0 0 0 / .46)); } :global(:root[data-theme='dark']) .door::before { background:linear-gradient(90deg,rgb(233 190 112 / .06),transparent 8% 92%,rgb(233 190 112 / .06)); } :global(:root[data-theme='dark']) .door::after { background:rgb(224 182 108 / .20); } :global(:root[data-theme='dark']) .door[data-door='vase']::after { background:rgb(209 136 126 / .15); } :global(:root[data-theme='dark']) .door[data-door='flower']::after { background:rgb(156 174 118 / .14); } :global(:root[data-theme='dark']) .icon-frame { border-color:rgb(224 182 108 / .62); background:rgb(12 22 38 / .26); box-shadow:inset 0 0 0 4px rgb(224 182 108 / .035); } :global(:root[data-theme='dark']) .door-icon { stroke:#d9b16d; } :global(:root[data-theme='dark']) .door h3::after { background:#d9b16d; } :global(:root[data-theme='dark']) .door p { color:#c7bead; } :global(:root[data-theme='dark']) .desk-note { color:#d1c3a8; background:linear-gradient(100deg,rgb(230 192 121 / .06),transparent 40%),#19263c; filter:drop-shadow(3px 5px 5px rgb(0 0 0 / .30)); } :global(:root[data-theme='dark']) .desk-note strong { color:#efd9a8; }
  @media (max-width:960px) { .home-canvas { padding:0 19px; } .hero { min-height:430px; } .doors { grid-template-columns:repeat(2,minmax(0,1fr)); } .door { min-height:270px; } } @media (max-width:620px) { .desk-note { grid-template-columns:auto 1fr; padding:22px 27px; } .desk-note span:last-child { grid-column:1/-1; } } @media (max-width:560px) { .home-canvas { min-height:calc(100vh - 108px); } .room-decor::before,.room-decor::after { background-size:auto 100%; background-position:center top; } .hero { min-height:calc(100vh - 120px); } .doors { grid-template-columns:1fr; gap:18px; } .door { min-height:265px; } } @media (prefers-reduced-motion:reduce) { .room-decor::before,.room-decor::after,.door { transition:none; } .door.reveal { opacity:1; transform:none; } }
</style>
