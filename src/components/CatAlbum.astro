---
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const count = 33;
const videoCount = 4;
const photos = Array.from({ length: count }, (_, i) => `/images/cats/cat-${String(i + 1).padStart(2, '0')}.jpg`);
const videos = Array.from({ length: videoCount }, (_, i) => `/videos/cats/cat-vid-${String(i + 1).padStart(2, '0')}.mp4`);
const closeLabel = zh ? '关闭' : 'Close';
const videosLabel = zh ? '视频' : 'Videos';
---
<div class="cat-album">
  <div class="cat-grid">
    {photos.map((src, i) => (
      <button type="button" class="cat-thumb" data-cat-open data-src={src} aria-label={zh ? `打开第 ${i + 1} 张照片` : `Open photo ${i + 1}`}>
        <img src={src} alt="" loading="lazy" />
      </button>
    ))}
  </div>
  <h4 class="cat-videos-label">{videosLabel}</h4>
  <div class="cat-videos">
    {videos.map((src) => (
      <div class="cat-video-wrap">
        <video class="cat-video" poster={src.replace(/\.mp4$/, '-poster.jpg')} preload="none" playsinline data-src={src}></video>
        <button type="button" class="cat-video-play" data-cat-video-play aria-label={zh ? '播放' : 'Play'}>&#9654;</button>
      </div>
    ))}
  </div>
  <div class="cat-lightbox" data-cat-lightbox hidden>
    <button type="button" class="cat-close" data-cat-close aria-label={closeLabel}>&times;</button>
    <img data-cat-lightbox-img src="" alt="" />
  </div>
</div>

<style>
  .cat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:8px; margin-top:18px; }
  .cat-thumb { padding:0; border:1px solid var(--line); background:none; cursor:zoom-in; aspect-ratio:1; overflow:hidden; }
  .cat-thumb img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .3s ease; }
  .cat-thumb:hover img { transform:scale(1.04); }
  .cat-lightbox { position:fixed; inset:0; z-index:20; background:rgb(10 14 24 / .86); align-items:center; justify-content:center; padding:5vh 4vw; }
  .cat-lightbox:not([hidden]) { display:flex; }
  .cat-lightbox img { max-width:100%; max-height:100%; box-shadow:0 12px 40px rgb(0 0 0 / .4); }
  .cat-close { position:absolute; top:18px; right:22px; background:none; border:1px solid rgb(244 234 217 / .5); color:#f4ead9; width:38px; height:38px; border-radius:999px; font-size:1.4rem; line-height:1; cursor:pointer; }
  .cat-videos-label { font:.68rem ui-monospace,SFMono-Regular,monospace; color:var(--rose); letter-spacing:.06em; text-transform:uppercase; margin:32px 0 12px; }
  .cat-videos { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }
  .cat-video-wrap { position:relative; }
  .cat-video { width:100%; max-height:360px; border:1px solid var(--line); background:#000; display:block; }
  .cat-video-play { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:52px; height:52px; border-radius:999px; background:rgb(10 14 24 / .6); border:1px solid rgb(244 234 217 / .7); color:#f4ead9; font-size:1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .cat-video-play:disabled { opacity:.5; cursor:wait; }
  @media (prefers-reduced-motion:reduce) { .cat-thumb img { transition:none; } }
</style>

<script is:inline>
  document.addEventListener('click', function (event) {
    var target = event.target;
    var openBtn = target.closest('[data-cat-open]');
    if (openBtn) {
      var album = openBtn.closest('.cat-album');
      var box = album && album.querySelector('[data-cat-lightbox]');
      var img = album && album.querySelector('[data-cat-lightbox-img]');
      if (box && img) { img.src = openBtn.getAttribute('data-src') || ''; box.hidden = false; }
      return;
    }
    var closeBtn = target.closest('[data-cat-close]');
    var lightbox = target.closest('.cat-lightbox');
    if (closeBtn || target.hasAttribute('data-cat-lightbox')) {
      var openLightbox = target.closest('.cat-album') && target.closest('.cat-album').querySelector('[data-cat-lightbox]');
      if (openLightbox) openLightbox.hidden = true;
      return;
    }
    var playBtn = target.closest('[data-cat-video-play]');
    if (playBtn) {
      var wrap = playBtn.closest('.cat-video-wrap');
      var video = wrap && wrap.querySelector('video.cat-video');
      if (!video) return;
      playBtn.disabled = true;
      fetch(video.dataset.src)
        .then(function (res) { return res.blob(); })
        .then(function (blob) {
          video.src = URL.createObjectURL(blob);
          video.controls = true;
          video.load();
          return video.play();
        })
        .then(function () { playBtn.remove(); })
        .catch(function () { playBtn.disabled = false; });
    }
  });
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    document.querySelectorAll('[data-cat-lightbox]').forEach(function (box) { box.hidden = true; });
  });
</script>
