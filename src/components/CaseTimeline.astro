---
interface Node { time: string; title: string; desc: string; status: 'done' | 'open'; }
interface Track { label?: string; nodes: Node[]; }
interface CaseData { label: string; title: string; tracks: Track[]; }
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const zh = lang === 'zh';

const cases: CaseData[] = zh ? [
  {
    label: '案件 A',
    title: '房东租务纠纷（LTB）',
    tracks: [{ nodes: [
      { time: '2025年10月中', title: '提交申请', desc: '房东未经同意乱扣钱，向房东与租客委员会（LTB）提交申请。', status: 'done' },
      { time: '2026年2月底', title: '第一次开庭', desc: '首次听证，和解未成。', status: 'done' },
      { time: '2026年9月中', title: '正式开庭', desc: '进入正式审理阶段。', status: 'open' },
    ]}],
  },
  {
    label: '案件 B',
    title: 'PGWP 拒签与再申请（IRCC）',
    tracks: [{ nodes: [
      { time: '2026年3月初', title: '收到拒信', desc: 'PGWP 申请被拒。', status: 'done' },
      { time: '同期', title: '提交 Reconsideration', desc: '收到拒信后立刻提交复议申请，并寻求他人协助与意见。', status: 'done' },
      { time: '2026年4月底', title: '下签', desc: '复议成功，案件完结。', status: 'done' },
    ]}],
  },
  {
    label: '案件 C',
    title: '劳务纠纷（用工身份误分类）',
    tracks: [
      { label: 'CRA 身份裁定', nodes: [
        { time: '2026年6月底', title: '递交裁定申请', desc: '就用工身份误分类问题向 CRA 申请正式裁定。', status: 'done' },
        { time: '2026年8月底', title: '裁定结果', desc: 'CRA 裁定为雇员身份，此线完结。', status: 'done' },
      ]},
      { label: 'Small Claims 索赔', nodes: [
        { time: '2026年8月底', title: '提交索赔', desc: '向法院提交小额索赔申请。', status: 'open' },
      ]},
    ],
  },
] : [
  {
    label: 'Case A',
    title: 'Landlord Dispute (LTB)',
    tracks: [{ nodes: [
      { time: 'Mid Oct 2025', title: 'Application filed', desc: 'Filed with the Landlord and Tenant Board after unauthorized deductions from a deposit.', status: 'done' },
      { time: 'Late Feb 2026', title: 'First hearing', desc: 'First hearing; settlement attempt failed.', status: 'done' },
      { time: 'Mid Sep 2026', title: 'Formal hearing', desc: 'Case moves into formal hearing.', status: 'open' },
    ]}],
  },
  {
    label: 'Case B',
    title: 'PGWP Refusal & Reconsideration (IRCC)',
    tracks: [{ nodes: [
      { time: 'Early Mar 2026', title: 'Refusal received', desc: 'PGWP application refused.', status: 'done' },
      { time: 'Same period', title: 'Reconsideration filed', desc: 'Filed a reconsideration request immediately, and rallied support.', status: 'done' },
      { time: 'Late Apr 2026', title: 'Approved', desc: 'Reconsideration succeeded; case closed.', status: 'done' },
    ]}],
  },
  {
    label: 'Case C',
    title: 'Employment Misclassification',
    tracks: [
      { label: 'CRA ruling', nodes: [
        { time: 'Late Jun 2026', title: 'Ruling request filed', desc: 'Requested a formal CRA ruling on worker status.', status: 'done' },
        { time: 'Late Aug 2026', title: 'Ruling issued', desc: 'CRA ruled employee status; this track closed.', status: 'done' },
      ]},
      { label: 'Small Claims', nodes: [
        { time: 'Late Aug 2026', title: 'Claim filed', desc: 'Filed a small claims court claim.', status: 'open' },
      ]},
    ],
  },
];
---
<div class="ep-layout case-ep-layout">
  <div class="ep-tabs">
    {cases.map((c, i) => (
      <button type="button" class={`ep-tab${i === 0 ? ' active' : ''}`} data-ep={i}>{c.label} · {c.title}</button>
    ))}
  </div>
  <div class="ep-panels">
    {cases.map((c, i) => (
      <div class={`ep-panel${i === 0 ? ' active' : ''}`} data-ep={i}>
        <p class="ct-label">{c.label}</p>
        <h2 class="ep-title">{c.title}</h2>
        {c.tracks.map((track) => (
          <div class="ct-track">
            {track.label && <p class="ct-track-label">{track.label}</p>}
            <div class="ct-nodes">
              {track.nodes.map((n) => (
                <div class="ct-node">
                  <span class={`ct-dot ${n.status}`}></span>
                  <div class="ct-node-body">
                    <p class="ct-time">{n.time}</p>
                    <p class="ct-node-title">{n.title}</p>
                    <p class="ct-desc">{n.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .case-ep-layout { margin-top:24px; display:grid; grid-template-columns:230px 1fr; gap:36px; align-items:start; }
  .case-ep-layout .ep-tabs { display:flex; flex-direction:column; position:sticky; top:24px; }
  .case-ep-layout .ep-tab { text-align:left; background:none; border:none; border-left:2px solid var(--line); padding:11px 16px; font:inherit; font-size:.93rem; color:var(--muted); cursor:pointer; line-height:1.4; transition:color .18s ease,border-color .18s ease; }
  .case-ep-layout .ep-tab:hover { color:var(--ink); }
  .case-ep-layout .ep-tab.active { border-left-color:var(--rose); color:var(--ink); font-weight:500; }
  .case-ep-layout .ep-panels { min-width:0; }
  .case-ep-layout .ep-panel { display:none; }
  .case-ep-layout .ep-panel.active { display:block; }
  .case-ep-layout .ep-title { margin:8px 0 20px; font-size:clamp(1.5rem,3vw,2.1rem); line-height:1.25; font-weight:500; }
  .case-ep-layout .ep-panel.entering { animation: ep-panel-in .52s cubic-bezier(.2,.7,.2,1) both; }
  .ct-label { font:.68rem ui-monospace,SFMono-Regular,monospace; color:var(--rose); letter-spacing:.06em; text-transform:uppercase; margin:0; }
  .ct-track { margin-bottom:18px; }
  .ct-track:last-child { margin-bottom:0; }
  .ct-track-label { font:.78rem ui-sans-serif,system-ui,sans-serif; color:var(--muted); letter-spacing:.03em; margin:0 0 10px; }
  .ct-nodes { position:relative; padding-left:24px; }
  .ct-nodes::before { content:''; position:absolute; left:5px; top:6px; bottom:6px; width:2px; background:var(--line); }
  .ct-node { position:relative; padding-bottom:22px; }
  .ct-node:last-child { padding-bottom:0; }
  .ct-dot { position:absolute; left:-24px; top:5px; width:12px; height:12px; border-radius:999px; background:var(--rose); }
  .ct-dot.open { background:var(--paper); border:2px solid var(--rose); }
  .ct-time { font:.72rem ui-sans-serif,system-ui,sans-serif; color:var(--muted); letter-spacing:.03em; margin:0 0 2px; }
  .ct-node-title { font-size:1.05rem; margin:0 0 4px; }
  .ct-desc { color:var(--muted); font-size:.92rem; margin:0; }
  @keyframes ep-panel-in { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
  @media (max-width:760px) { .case-ep-layout { grid-template-columns:1fr; } .case-ep-layout .ep-tabs { flex-direction:row; flex-wrap:wrap; position:static; gap:4px 14px; } .case-ep-layout .ep-tab { border-left:none; border-bottom:2px solid var(--line); padding:6px 2px; } .case-ep-layout .ep-tab.active { border-bottom-color:var(--rose); } }
  @media (prefers-reduced-motion:reduce) { .case-ep-layout .ep-panel.entering { animation:none; } }
</style>

<script is:inline>
  document.addEventListener('click', function (event) {
    var tab = event.target.closest('.case-ep-layout .ep-tab');
    if (!tab) return;
    var layout = tab.closest('.case-ep-layout');
    var tabs = layout.querySelectorAll('.ep-tab');
    var panels = layout.querySelectorAll('.ep-panel');
    tabs.forEach(function (t) { t.classList.remove('active'); });
    panels.forEach(function (p) { p.classList.remove('active', 'entering'); });
    tab.classList.add('active');
    var panel = layout.querySelector('.ep-panel[data-ep="' + tab.dataset.ep + '"]');
    if (!panel) return;
    panel.classList.add('active');
    window.requestAnimationFrame(function () { panel.classList.add('entering'); });
  });
</script>
