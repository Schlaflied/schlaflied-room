---
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const zh = lang === 'zh';
---
<span class="contact-row">
  <a href="https://github.com/Schlaflied" target="_blank" rel="noopener"><svg class="contact-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>GitHub</a>
  <a href="mailto:200203syttt@gmail.com"><svg class="contact-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1" stroke="currentColor" stroke-width="1.1"/><path d="M2.5 4.5L8 9L13.5 4.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>Email</a>
  <span class="wechat-widget">
    <button type="button" class="wechat-toggle" data-wechat-toggle><svg class="contact-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 2.5C4.7 2.5 2 4.6 2 7.2C2 8.7 2.9 10 4.3 10.9L3.8 12.8L5.9 11.7C6.55 11.85 7.26 11.9 8 11.9C11.3 11.9 14 9.8 14 7.2C14 4.6 11.3 2.5 8 2.5Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/><circle cx="5.8" cy="7" r="0.6" fill="currentColor"/><circle cx="10.2" cy="7" r="0.6" fill="currentColor"/></svg>{zh ? '微信' : 'WeChat'}</button>
    <span class="wechat-pop" data-wechat-pop hidden>
      <button type="button" class="wechat-close" data-wechat-close aria-label={zh ? '关闭' : 'Close'}>&times;</button>
      <img src="/images/contact/wechat-qr.jpg" alt="WeChat QR code" />
    </span>
  </span>
</span>

<style>
  .contact-row { display:inline-flex; gap:18px; align-items:center; font-family:ui-sans-serif,system-ui,sans-serif; letter-spacing:.03em; font-size:.86rem; }
  .contact-row a { color:var(--muted); display:inline-flex; align-items:center; gap:5px; }
  .contact-row a:hover { color:var(--rose); }
  .contact-icon { width:14px; height:14px; flex:none; }
  .wechat-widget { position:relative; display:inline-block; }
  .wechat-toggle { appearance:none; background:none; border:0; padding:0; color:var(--muted); font:inherit; letter-spacing:inherit; cursor:pointer; display:inline-flex; align-items:center; gap:5px; }
  .wechat-toggle:hover { color:var(--rose); }
  .wechat-pop { position:absolute; left:0; top:calc(100% + 10px); background:var(--paper); border:1px solid var(--line); padding:14px; box-shadow:0 10px 30px rgb(0 0 0 / .18); z-index:5; }
  .wechat-pop img { display:block; width:260px; height:auto; }
  .wechat-close { position:absolute; top:4px; right:6px; appearance:none; background:none; border:0; color:var(--muted); font-size:1.1rem; line-height:1; cursor:pointer; }
</style>
